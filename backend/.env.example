ENV=development
DATABASE_URL=postgresql://user:password@host:5432/globetrotter
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=12
CORS_ORIGINS=http://localhost:5173

# AI suggestion chatbot (modules/chatbot). Leave OPENROUTER_API_KEY blank to
# run with the rule-based fallback only — the feature degrades gracefully.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_DAILY_LIMIT=200
